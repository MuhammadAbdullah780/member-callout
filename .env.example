# Postgres
POSTGRES_DB=crewlink
POSTGRES_USER=crewlink
POSTGRES_PASSWORD=crewlink
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional AI provider (OpenRouter - https://openrouter.ai/keys)
# Without a key the AI draft endpoint returns a clean 502 and manual entry works.
# AI_PROVIDER_MODEL is a comma-separated preference order, tried left to right,
# so a rate-limited free model falls through to the next.
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_MODEL=cohere/north-mini-code:free,google/gemma-4-31b-it:free
