:"Community 5"},"design_send_path":{"id":"design_send_path","description":{"status":"generated","description":"API returns 202 immediately without iterating all members in-request; outbox publisher + fan-out worker inserts deliveries via INSERT ... ON CONFLICT DO NOTHING in batches so it can restart at any point; notification workers log attempts using announcement/delivery ID as dedup key; status screen uses SSE/WebSocket instead of per-row polling.","source":"rationale","provisional":true},"occurrences":null,"type":"document","community":0,"community_name":"Community 0"},"design_rule1_isolation":{"id":"design_rule1_isolation","description":{"status":"generated","description":"API never trusts browser-supplied local_id/role; server-verified actor scopes every read/write; centralized permission class for leadership routes; DB row-level security as defense in depth so unscoped queries fail closed; member endpoints require delivery.member_id match.","source":"rationale","provisional":true},"occurrences":null,"type":"document","community":0,"community_name":"Community 0"},"design_rule2_retry_safety":{"id":"design_rule2_retry_safety","description":{"status":"generated","description":"Database (not button state/process memory) owns idempotency: send idempotency key stops duplicate announcements, unique (announcement_id, member_id) stops duplicate recipients under redelivery/concurrency; outbox avoids lost queue jobs after commit; workers at-least-once but idempotent; mobile inbox dedups by delivery ID.","source":"rationale","provisional":true},"occurrences":null,"type":"document","community":0,"community_name":"Community 0"},"design_detection":{"id":"design_detection","description":{"status":"generated","description":"Immutable audit events plus monitoring on policy denials, cross-local references, duplicate-key conflicts, fan-out completion, queue age, notification failures.","source":"rationale","provisional":true},"occurrences":null,"type":"document","community":0,"co